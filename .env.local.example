# Google Maps Platform API Key
# Must have "Maps JavaScript API" and "Places API (New)" enabled in Google Cloud Console.
# For production, restrict this key to your HTTP referrers (e.g., https://yourdomain.com/*)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Custom Map ID created in Google Cloud Console with vector rendering and custom styling
# If not provided, the default DEMO_MAP_ID will be used.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
