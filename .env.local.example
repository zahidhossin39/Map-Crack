# ---------------------------------------------------------------------------
# Use TWO separate keys. They cannot be the same key.
#
# This one is embedded in the JavaScript sent to every visitor's browser, so it
# must be locked down by HTTP referrer. That is only safe because it is never
# used for server-side calls.
#   Enable:   Maps JavaScript API
#   Restrict: HTTP referrers -> https://yourdomain.com/*  (and http://localhost:3000/*)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Server-only key used by /api/places/*. Never sent to the browser, so it can be
# IP-restricted. A referrer restriction would BREAK this key, because
# server-to-server requests send no Referer header.
#   Enable:   Places API (New)
#   Restrict: IP addresses -> your server's egress IP (leave unrestricted locally)
#
# If this is unset the server falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY and
# logs a warning. That fallback works, but it forces the public key to stay
# unrestricted, which means anyone can lift it from the JS bundle and spend your
# Google billing. Set this before deploying.
# ---------------------------------------------------------------------------
GOOGLE_PLACES_SERVER_KEY=

# Turso database for saving selections, statuses and scans (free tier). Server-only.
# Create with: turso db create map-crack ; turso db show --url map-crack ; turso db tokens create map-crack
# Leave empty to keep everything in this browser only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: Custom Map ID created in Google Cloud Console with vector rendering and custom styling
# If not provided, the default DEMO_MAP_ID will be used.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
